@model List<RaceDayApi.Client.Models.Event>

    <h2>Available Events</h2>
@foreach (var item in Model)
{
    <div>
        <h4>@item.EventName</h4>
        <p>@item.EventDate</p>
        <p>@item.EventLocation</p>
    </div>
}

<h2>Available Courses</h2>
@foreach (var item in Model)
{
    <div>
        <h4>@item.EventName</h4>
        <p>Lecturer: @item.OrganizerName</p>
    </div>
}